<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the examples against a fake ingest and checks what Fixwire receives, so they keep working. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1861;CA1848;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <Content Include="../../test/Fixwire.Tests/xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ShopApi/ShopApi.csproj" />
    <ProjectReference Include="../NightlyReport/NightlyReport.csproj" />
  </ItemGroup>
</Project>
