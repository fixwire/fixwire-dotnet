<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Example: a cron job (a .NET worker) reporting to Fixwire. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA1050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fixwire.Extensions.Hosting/Fixwire.Extensions.Hosting.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
