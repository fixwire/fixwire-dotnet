<Project Sdk="Microsoft.NET.Sdk">
  <!-- Any .NET host (worker services, ASP.NET Core): setup from configuration, ILogger, IHttpClientFactory. -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Fixwire.Extensions.Hosting</PackageId>
    <Description>Fixwire for .NET hosts: set up from configuration, ILogger records as breadcrumbs and events, IHttpClientFactory clients traced, flushed when the host stops.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Fixwire/Fixwire.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fixwire.Tests" />
    <InternalsVisibleTo Include="Fixwire.AspNetCore" />
  </ItemGroup>
</Project>
